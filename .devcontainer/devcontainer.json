{
	"name": "homelab",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"initializeCommand": "bash -c 'mkdir -p ~/.claude/plugins ~/.claude/projects ~/.claude/sessions ~/.claude/plans ~/.claude/session-env && touch ~/.claude/history.jsonl'",
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway"
	],
	"mounts": [
		"source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/history.jsonl,target=/home/vscode/.claude/history.jsonl,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/plugins,target=/home/vscode/.claude/plugins,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/projects,target=/home/vscode/.claude/projects,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/sessions,target=/home/vscode/.claude/sessions,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/plans,target=/home/vscode/.claude/plans,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/session-env,target=/home/vscode/.claude/session-env,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/settings.json,target=/run/host-settings/settings.json,type=bind,readonly"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"redhat.vscode-yaml",
				"ms-azuretools.vscode-docker",
				"hashicorp.terraform",
				"github.vscode-github-actions",
				"fluxcd.flux-vscode",
				"eamodio.gitlens",
				"Anthropic.claude-code"
			]
		}
	},
	"postCreateCommand": ".devcontainer/postCreateCommand.sh",
	"postStartCommand": "bash -c 'sudo chown vscode:vscode ~/.claude || true && sudo cp /run/host-settings/settings.json ~/.claude/settings.json && sudo sed -i \"s|localhost:6655|host.docker.internal:6655|g\" ~/.claude/settings.json && sudo chown vscode:vscode ~/.claude/settings.json && echo \"✓ Claude settings written (proxy: host.docker.internal:6655)\"'",
	"remoteUser": "vscode"
}
