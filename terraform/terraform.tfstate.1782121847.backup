            "content": "\"cluster\":\n  \"aggregatorCA\":\n    \"crt\": \"\"\n    \"key\": \"\"\n  \"apiServer\":\n    \"admissionControl\":\n    - \"configuration\":\n        \"apiVersion\": \"pod-security.admission.config.k8s.io/v1alpha1\"\n        \"defaults\":\n          \"audit\": \"restricted\"\n          \"audit-version\": \"latest\"\n          \"enforce\": \"baseline\"\n          \"enforce-version\": \"latest\"\n          \"warn\": \"restricted\"\n          \"warn-version\": \"latest\"\n        \"exemptions\":\n          \"namespaces\":\n          - \"kube-system\"\n          \"runtimeClasses\": []\n          \"usernames\": []\n        \"kind\": \"PodSecurityConfiguration\"\n      \"name\": \"PodSecurity\"\n    \"auditPolicy\":\n      \"apiVersion\": \"audit.k8s.io/v1\"\n      \"kind\": \"Policy\"\n      \"rules\":\n      - \"level\": \"Metadata\"\n    \"image\": \"registry.k8s.io/kube-apiserver:v1.36.0\"\n  \"ca\":\n    \"crt\": \"\"\n    \"key\": \"\"\n  \"clusterName\": \"homelab\"\n  \"controlPlane\":\n    \"endpoint\": \"https://192.168.123.20:6443\"\n  \"controllerManager\":\n    \"extraArgs\":\n      \"bind-address\": \"0.0.0.0\"\n    \"image\": \"registry.k8s.io/kube-controller-manager:v1.36.0\"\n  \"discovery\":\n    \"enabled\": true\n    \"registries\":\n      \"kubernetes\":\n        \"disabled\": true\n      \"service\": {}\n  \"etcd\":\n    \"ca\":\n      \"crt\": \"\"\n      \"key\": \"\"\n  \"id\": \"_VziAGjGXw2N-AUG_8gTAnxdXabIVZGA3VbC37_8TjY=\"\n  \"network\":\n    \"cni\":\n      \"name\": \"none\"\n    \"dnsDomain\": \"cluster.local\"\n    \"podSubnets\":\n    - \"10.244.0.0/16\"\n    \"serviceSubnets\":\n    - \"10.96.0.0/12\"\n  \"proxy\":\n    \"disabled\": true\n  \"scheduler\":\n    \"extraArgs\":\n      \"bind-address\": \"0.0.0.0\"\n    \"image\": \"registry.k8s.io/kube-scheduler:v1.36.0\"\n  \"secret\": \"WQt00uAIAlN0hjhJBHi486ewsGRXkTFGbdKOpcI2BB8=\"\n  \"secretboxEncryptionSecret\": \"1ZbLP1sC0LAa+bsLcT0V8fwjP3Gfjp03LdUtNNjXqH0=