          "schema_version": 0,
          "attributes": {
            "content": "\"cluster\":\n  \"ca\":\n    \"crt\": \"\"\n    \"key\": \"\"\n  \"clusterName\": \"homelab\"\n  \"controlPlane\":\n    \"endpoint\": \"https://192.168.123.20:6443\"\n  \"discovery\":\n    \"enabled\": true\n    \"registries\":\n      \"kubernetes\":\n        \"disabled\": true\n      \"service\": {}\n  \"id\": \"_VziAGjGXw2N-AUG_8gTAnxdXabIVZGA3VbC37_8TjY=\"\n  \"network\":\n    \"dnsDomain\": \"cluster.local\"\n    \"podSubnets\":\n    - \"10.244.0.0/16\"\n    \"serviceSubnets\":\n    - \"10.96.0.0/12\"\n  \"secret\": \"WQt00uAIAlN0hjhJBHi486ewsGRXkTFGbdKOpcI2BB8=\"\n  \"token\": \"cvtkew.stk8xcp5u4no1q8w\"\n\"debug\": false\n\"machine\":\n  \"ca\":\n    \"crt\": \"\"\n    \"key\": \"\"\n  \"certSANs\": []\n  \"features\":\n    \"diskQuotaSupport\": true\n    \"hostDNS\":\n      \"enabled\": true\n      \"forwardKubeDNSToHost\": true\n    \"kubePrism\":\n      \"enabled\": true\n      \"port\": 7445\n    \"stableHostname\": false\n  \"install\":\n    \"disk\": \"/dev/vda\"\n    \"grubUseUKICmdline\": true\n    \"image\": \"factory.talos.dev/installer-secureboot/a72961cff61328db9bf029a0cc90eef92a5de708c83853e0c97fd87b8efe247e:v1.13.2\"\n    \"wipe\": false\n  \"kernel\":\n    \"modules\":\n    - \"name\": \"nvme_tcp\"\n    - \"name\": \"vfio_pci\"\n  \"kubelet\":\n    \"defaultRuntimeSeccompProfileEnabled\": true\n    \"disableManifestsDirectory\": true\n    \"extraConfig\":\n      \"memorySwap\":\n        \"swapBehavior\": \"LimitedSwap\"\n    \"extraMounts\":\n    - \"destination\": \"/var/lib/longhorn\"\n      \"options\":\n      - \"bind\"\n      - \"rshared\"\n      - \"rw\"\n      \"source\": \"/var/lib/longhorn\"\n      \"type\": \"bind\"\n    \"image\": \"ghcr.io/siderolabs/kubelet:v1.36.0\"\n  \"logging\":\n    \"destinations\":\n    - \"endpoint\": \"tcp://127.0.0.1:30517/\"\n      \"extraTags\":\n        \"node\": \"talos-worker-1\"\n      \"format\": \"json_lines\"\n  \"sysctls\":\n    \"vm.page-cluster\": \"0\"\n    \"vm.swappiness\": \"130\"\n  \"token\": \"6ri18o.4tv3sdtnnve14u2l\"\n  \"type\": \"worker\"\n\"persist\": true\n\"version\": \"v1alpha1\"\n---\n---\napiVersion: v1alpha1\nkind: VolumeConfig\nname: STATE\nencryption:\n  provider: luks2\n  keys:\n    - tpm:\n        options:\n          pcrs: [7]\n      slot: 0\n---\napiVersion: v1alpha1\nkind: VolumeConfig\nname: EPHEMERAL\nencryption:\n  provider: luks2\n  keys:\n    - tpm:\n        options:\n          pcrs: [7]\n      slot: 0\n      lockToState: true\n---\napiVersion: v1alpha1\nkind: HostnameConfig\nhostname: talos-worker-1\n---\napiVersion: v1alpha1\nkind: LinkConfig\nname: ens18\nup: true\naddresses:\n  - address: 10.10.20.21/24\nroutes:\n  - gateway: 10.10.20.2  # Control plane - has internet access\n  - destination: 192.168.123.0/24\n    gateway: 10.10.20.2  # Management network via control plane\n  - destination: 192.168.178.0/24\n    gateway: 10.10.20.2  # Horsmar network via FritzBox VPN\n---\napiVersion: v1alpha1\nkind: ResolverConfig\nnameservers:\n  - address: 192.168.123.1\n  - address: 8.8.8.8\n  - address: 1.1.1.1\n---\n# Forward kernel (dmesg) logs to Fluent Bit via local NodePort on this node.\n# Service log forwarding (machine.logging) is configured in terraform/talos.tf.\napiVersion: v1alpha1\nkind: KmsgLogConfig\nname: fluent-bit\nurl: \"tcp://127.0.0.1:30517/\"\n---\n# Longhorn CSI storage volume\n# This creates a formatted partition on the dedicated user volume disk (virtio2)\n# and mounts it at /var/mnt/longhorn for use by Longhorn as hostPath storage\napiVersion: v1alpha1\nkind: UserVolumeConfig\nname: longhorn\nprovisioning:\n  diskSelector:\n    # Match the dedicated storage disk: non-system virtio disk larger than 100GB\n    # This excludes the system disk (64GB) and swap disk (8GB)\n    match: '!system_disk \u0026\u0026 disk.transport == \"virtio\" \u0026\u0026 disk.size \u003e 100u * GiB'\n  grow: true  # Use all available space on the disk\n  minSize: 10GiB\nencryption:\n  provider: luks2\n  keys:\n    - tpm:\n        options:\n          pcrs: [7]\n      slot: 0\n      lockToState: true\n",
