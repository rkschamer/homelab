        "KUBECONFIG": "${workspaceFolder}/kubeconfig.yaml",
        "KUBE_EDITOR": "code --wait",
        "TALOSCONFIG": "${workspaceFolder}/talosconfig",
    },
    "claudeCode.environmentVariables": [
        {
            "name": "KUBECONFIG",
