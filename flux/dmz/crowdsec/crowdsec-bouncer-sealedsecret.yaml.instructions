# CrowdSec Traefik Bouncer API Key - SealedSecret
#
# HOW TO GENERATE:
#
# 1. Wait for CrowdSec LAPI pod to be running:
#      kubectl rollout status deployment/crowdsec-lapi -n crowdsec
#
# 2. Register the Traefik bouncer and capture its API key:
#      kubectl exec -n crowdsec deployment/crowdsec-lapi -- \
#        cscli bouncers add traefik-bouncer -o raw
#
# 3. Create the Kubernetes Secret (dry-run):
#      kubectl create secret generic crowdsec-bouncer-key \
#        --namespace traefik \
#        --from-literal=api-key=<PASTE_KEY_HERE> \
#        --dry-run=client -o yaml > /tmp/bouncer-secret.yaml
#
# 4. Seal it:
#      kubeseal --format=yaml < /tmp/bouncer-secret.yaml > \
#        flux/dmz/crowdsec/crowdsec-bouncer-sealedsecret.yaml
#
# 5. Replace this file with the generated SealedSecret and commit.
#
# The sealed secret will look like the example below (values will differ):
#
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: crowdsec-bouncer-key
#   namespace: traefik
# spec:
#   encryptedData:
#     api-key: AgCYg9x...
#   template:
#     metadata:
#       name: crowdsec-bouncer-key
#       namespace: traefik
#     type: Opaque
